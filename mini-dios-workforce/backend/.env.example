# Mini-DIOS Plastics — Backend Configuration
# Official google-genai SDK settings (leave GEMINI_API_KEY blank or set OFFLINE_MODE=true for air-gapped demos)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
OFFLINE_MODE=false

# Hosted Demo Auth Gate (set AUTH_ENABLED=true in production Docker/Render deployments)
AUTH_ENABLED=false
AUTH_SECRET_KEY=change-me-to-a-long-random-32-byte-secret
DEMO_ACCESS_CODES=Executive Demo:DIOS-2026,Alexandria Plant:ALEX-2026,Riyadh Plant:KSA-2026
ADMIN_PASSWORD=
ALLOW_INSTANT_DEMO=false

# Per-session live Gemini Copilot hourly cap (falls back automatically to deterministic offline CP-SAT)
COPILOT_MAX_LIVE_CALLS_PER_HOUR=15

# CORS allowed frontend origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional PostgreSQL Persistence (Neon / Supabase / Render Postgres).
# When unset, Mini-DIOS automatically falls back to local SQLite (data/mini_dios.db or DIOS_AUDIT_DB).
DATABASE_URL=
